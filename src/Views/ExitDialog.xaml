<Window x:Class="ThinkCanvas.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退出 ThinkCanvas" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#272B30">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#25292E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAEDEF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE2E5"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#F4F6F6"/><Setter Property="BorderBrush" Value="#CFD7D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAEDEF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE2E5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#21745F"/><Setter Property="BorderBrush" Value="#21745F"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A6552"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#145443"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B42318"/><Setter Property="BorderBrush" Value="#B42318"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#9E1F15"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#861A11"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#AAB4B7" BorderThickness="1" Background="White"><TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#19826A"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#21745F"/><Setter TargetName="Box" Property="BorderBrush" Value="#21745F"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="14" Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect Color="#40000000" BlurRadius="22" ShadowDepth="5" Opacity="0.32"/></Border.Effect>
        <StackPanel>
            <Grid Margin="20,16,20,0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" Background="#FBEAE8">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#B42318" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="退出 ThinkCanvas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" IsCancel="True" ToolTip="取消" AutomationProperties.Name="取消">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#667277"/>
                </Button>
            </Grid>
            <TextBlock Text="要退出程序，还是最小化到系统托盘？" Foreground="#4F5A5E" Margin="20,14,20,0" TextWrapping="Wrap"/>
            <TextBlock Text="最小化后悬浮工具栏和快捷键将停用，点击托盘图标可随时恢复。" Foreground="#78858A" FontSize="12" Margin="20,6,20,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="DontAskBox" Content="不再询问（之后可在设置中重新开启）" Margin="20,16,20,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,18,20,20">
                <Button Content="取消" Style="{StaticResource ActionButton}" IsCancel="True" Margin="0,0,10,0"/>
                <Button Content="最小化到托盘" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="TrayButton_OnClick" AutomationProperties.Name="最小化到托盘"/>
                <Button Content="退出程序" Style="{StaticResource DangerButton}" Click="ExitButton_OnClick" AutomationProperties.Name="退出程序"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
