<Window x:Class="ThinkCanvas.CaptureResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThinkCanvas 截图" Width="720" Height="520" MinWidth="340" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#272B30">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAEDEF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE2E5"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TextField" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F7F9F9"/>
            <Setter Property="BorderBrush" Value="#CFD7D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#8FC7B8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#9EAAAD"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#19826A"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#F4F6F6"/><Setter Property="BorderBrush" Value="#CFD7D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAEDEF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE2E5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#21745F"/><Setter Property="BorderBrush" Value="#21745F"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A6552"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#145443"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent"><Ellipse x:Name="Ring" Width="30" Height="30" Stroke="Transparent" StrokeThickness="2"/><Ellipse Width="22" Height="22" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="1"/></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#AAB4B7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#19826A"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="14" Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect Color="#40000000" BlurRadius="22" ShadowDepth="5" Opacity="0.32"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#E1EFEB">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#21745F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="截图预览" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,10,0" IsCancel="True" ToolTip="关闭" AutomationProperties.Name="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#667277"/>
                </Button>
            </Grid>
            <Border Grid.Row="1" Margin="16,0" Background="White" BorderBrush="#E4E8E9" BorderThickness="1" CornerRadius="6">
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
            </Border>
            <StackPanel Grid.Row="2" Margin="16,12,16,14">
                <StackPanel Orientation="Horizontal" Height="32" Margin="0,0,0,12">
                    <TextBlock Text="背景" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <RadioButton x:Name="KeepBackgroundRadio" Content="保留背景" GroupName="BackgroundMode" VerticalAlignment="Center" Margin="0,0,6,0" Checked="BackgroundMode_OnChanged"/>
                    <RadioButton x:Name="CustomBackgroundRadio" Content="自定义背景" GroupName="BackgroundMode" VerticalAlignment="Center" Margin="0,0,14,0" Checked="BackgroundMode_OnChanged"/>
                    <StackPanel x:Name="CustomColorPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button Style="{StaticResource SwatchButton}" Background="White" Tag="#FFFFFF" ToolTip="白色" Click="Swatch_OnClick"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#202020" Tag="#202020" ToolTip="黑色" Click="Swatch_OnClick"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#E7F2FF" Tag="#E7F2FF" ToolTip="浅蓝" Click="Swatch_OnClick"/>
                        <Button Style="{StaticResource SwatchButton}" Background="#E5F3E8" Tag="#E5F3E8" ToolTip="浅绿" Click="Swatch_OnClick"/>
                        <TextBox x:Name="CustomColorBox" Width="66" Height="30" MaxLength="7" VerticalAlignment="Center" TextChanged="CustomColor_OnChanged" ToolTip="自定义颜色 #RRGGBB"/>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#78858A" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="复制" Style="{StaticResource PrimaryButton}" MinWidth="72" Click="Copy_OnClick" Margin="0,0,10,0"/>
                        <Button Content="保存 PNG" Style="{StaticResource ActionButton}" MinWidth="88" Click="Save_OnClick"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
