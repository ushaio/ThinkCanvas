<Window x:Class="ThinkCanvas.ToolbarWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" Foreground="#272B30" Title="ThinkCanvas">
 <Window.Resources>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#25292E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style x:Key="Tool" TargetType="ButtonBase">
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Margin" Value="2,0"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTipService.InitialShowDelay" Value="350"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ButtonBase">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAEDEF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE2E5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.3"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Tool}"/>
  <Style x:Key="Mode" TargetType="RadioButton" BasedOn="{StaticResource Tool}">
   <Setter Property="Width" Value="70"/><Setter Property="Height" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Surface" CornerRadius="5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E0E7E6"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#21745F"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#111111"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Swatch" TargetType="RadioButton" BasedOn="{StaticResource Tool}">
   <Setter Property="Width" Value="30"/><Setter Property="Margin" Value="1,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid Background="Transparent">
     <Ellipse x:Name="Ring" Width="28" Height="28" Stroke="Transparent" StrokeThickness="1.5"/>
     <Ellipse Width="19" Height="19" Fill="{TemplateBinding Background}" Stroke="#18000000" StrokeThickness="1"/>
     <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#CCD3D6"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#111111"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/></Style>
  <Style x:Key="Divider" TargetType="Border"><Setter Property="Width" Value="1"/><Setter Property="Height" Value="24"/><Setter Property="Background" Value="#DEE3E5"/><Setter Property="Margin" Value="7,0"/></Style>
 </Window.Resources>
 <Border Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="8" Padding="6">
  <WrapPanel x:Name="ToolGroups" VerticalAlignment="Center">
   <StackPanel Orientation="Horizontal" Margin="0,2">
    <Border x:Name="DragHandle" Width="22" Height="40" Background="Transparent" Cursor="SizeAll" ToolTip="移动工具栏" MouseLeftButtonDown="DragHandle_OnMouseDown">
     <TextBlock Text="&#xE784;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#899499" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Border Background="#EDF1F0" CornerRadius="6" Padding="2" Height="40">
     <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="OperateButton" Style="{StaticResource Mode}" GroupName="Mode" Click="OperateButton_OnClick" AutomationProperties.Name="操作模式">
       <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE962;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="操作"/></StackPanel>
      </RadioButton>
      <RadioButton x:Name="ToggleButton" Style="{StaticResource Mode}" GroupName="Mode" Click="ToggleButton_OnClick" AutomationProperties.Name="书写模式">
       <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="书写"/></StackPanel>
      </RadioButton>
      <RadioButton x:Name="EraserButton" Style="{StaticResource Mode}" GroupName="Mode" Click="EraserButton_OnClick" AutomationProperties.Name="橡皮擦模式">
       <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE75C;" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="橡皮擦"/></StackPanel>
      </RadioButton>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Divider}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,2">
    <RadioButton x:Name="RedButton" Style="{StaticResource Swatch}" Background="Red" GroupName="InkColor" IsChecked="True" Click="RedButton_OnClick" ToolTip="红色" AutomationProperties.Name="红色笔"/>
    <RadioButton x:Name="BlueButton" Style="{StaticResource Swatch}" Background="#1769D2" GroupName="InkColor" Click="BlueButton_OnClick" ToolTip="蓝色" AutomationProperties.Name="蓝色笔"/>
    <RadioButton Style="{StaticResource Swatch}" Background="#25292E" GroupName="InkColor" Click="BlackButton_OnClick" ToolTip="黑色" AutomationProperties.Name="黑色笔"/>
    <Button x:Name="WidthButton" ToolTip="笔宽" Click="WidthButton_OnClick" AutomationProperties.Name="笔宽"><Ellipse x:Name="WidthDot" Width="4" Height="4" Fill="#272B30"/></Button>
    <Grid Width="40" Margin="3,0" ToolTip="笔压">
     <TextBlock x:Name="PressureText" Text="--" FontSize="10" Foreground="#78858A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6"/>
     <ProgressBar x:Name="PressureBar" Height="3" Minimum="0" Maximum="1" Value="0" BorderThickness="0" Background="#E6EBEB" Foreground="#21745F" VerticalAlignment="Bottom" Margin="2,0,2,8"/>
    </Grid>
    <Border Style="{StaticResource Divider}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,2">
    <Button x:Name="CaptureButton" Click="CaptureButton_OnClick" ToolTip="截图" AutomationProperties.Name="截图"><TextBlock Style="{StaticResource Glyph}" Text="&#xE722;"/></Button>
    <Button x:Name="ClearButton" Click="ClearButton_OnClick" IsEnabled="False" ToolTip="清空笔迹" AutomationProperties.Name="清空笔迹"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></Button>
    <Button x:Name="SettingsButton" Click="SettingsButton_OnClick" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/></Button>
    <Border Style="{StaticResource Divider}"/>
    <Button Width="32" Click="ExitButton_OnClick" ToolTip="退出 ThinkCanvas" AutomationProperties.Name="退出"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="13" Foreground="#78858A"/></Button>
   </StackPanel>
   <Popup x:Name="WidthPopup" PlacementTarget="{Binding ElementName=WidthButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
    <Border Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="6" Padding="16"><StackPanel Width="200">
     <DockPanel Margin="0,0,0,12"><TextBlock Text="笔宽"/><TextBlock x:Name="WidthValue" Text="4 px" HorizontalAlignment="Right"/></DockPanel>
     <Slider x:Name="WidthSlider" Minimum="1" Maximum="20" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="WidthSlider_OnValueChanged" AutomationProperties.Name="笔宽"/>
    </StackPanel></Border>
   </Popup>
   <Popup x:Name="ClearPopup" PlacementTarget="{Binding ElementName=ClearButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-10">
    <Border Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="6" Padding="16"><StackPanel>
     <TextBlock Text="清空全部笔迹？" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Width="64" Height="32" Content="取消" Click="CancelClear_OnClick"/><Button Width="64" Height="32" Content="清空" Foreground="#B42318" Click="ConfirmClear_OnClick"/></StackPanel>
    </StackPanel></Border>
   </Popup>
  </WrapPanel>
 </Border>
</Window>
