<Window x:Class="ThinkCanvas.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThinkCanvas 设置" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#F7F7F7" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
            <TextBlock Text="截图" VerticalAlignment="Center"/>
            <TextBox x:Name="CaptureShortcutBox" Grid.Column="1" Height="32" IsReadOnly="True"
                     VerticalContentAlignment="Center" PreviewKeyDown="Shortcut_OnKeyDown"/>
            <TextBlock Text="切换书写 / 操作" Grid.Row="1" VerticalAlignment="Center"/>
            <TextBox x:Name="ToggleShortcutBox" Grid.Row="1" Grid.Column="1" Height="32" IsReadOnly="True"
                     VerticalContentAlignment="Center" PreviewKeyDown="Shortcut_OnKeyDown"/>
        </Grid>
        <Separator Margin="0,18"/>
        <TextBlock Text="截图背景" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
        <CheckBox x:Name="SolidBackgroundBox" Content="使用纯色背景（仅保留笔迹）" Margin="0,0,0,16"/>
        <StackPanel IsEnabled="{Binding IsChecked, ElementName=SolidBackgroundBox}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Width="32" Height="32" Background="White" Tag="#FFFFFF" ToolTip="白色" Click="Swatch_OnClick" Margin="0,0,8,0"/>
                <Button Width="32" Height="32" Background="#202020" Tag="#202020" ToolTip="黑色" Click="Swatch_OnClick" Margin="0,0,8,0"/>
                <Button Width="32" Height="32" Background="#E7F2FF" Tag="#E7F2FF" ToolTip="浅蓝" Click="Swatch_OnClick" Margin="0,0,8,0"/>
                <Button Width="32" Height="32" Background="#E5F3E8" Tag="#E5F3E8" ToolTip="浅绿" Click="Swatch_OnClick" Margin="0,0,8,0"/>
            </StackPanel>
            <DockPanel>
                <TextBlock Text="自定义颜色" VerticalAlignment="Center" Width="120"/>
                <Border x:Name="ColorPreview" Width="32" Height="32" BorderThickness="1" BorderBrush="#999999" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBox x:Name="ColorBox" Height="32" MaxLength="7" VerticalContentAlignment="Center" TextChanged="Color_OnChanged"/>
            </DockPanel>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,16,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="80" Height="32" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="保存" Width="80" Height="32" IsDefault="True" Click="Save_OnClick"/>
        </StackPanel>
    </StackPanel>
</Window>
