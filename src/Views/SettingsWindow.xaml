<Window x:Class="ThinkCanvas.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ThinkCanvas 设置" Width="468" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        ShowInTaskbar="False" UseLayoutRounding="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#272B30">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#25292E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAEDEF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCE2E5"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TextField" TargetType="TextBox">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="#F7F9F9"/>
            <Setter Property="BorderBrush" Value="#CFD7D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="#8FC7B8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#9EAAAD"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#19826A"/><Setter TargetName="Field" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.55"/></Trigger>
                    <Trigger Property="Text" Value="未设置"><Setter Property="Foreground" Value="#9AA5A9"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="84"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#F4F6F6"/><Setter Property="BorderBrush" Value="#CFD7D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19826A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EAEDEF"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#DCE2E5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#21745F"/><Setter Property="BorderBrush" Value="#21745F"/><Setter Property="Foreground" Value="White"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A6552"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#145443"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent"><Ellipse x:Name="Ring" Width="34" Height="34" Stroke="Transparent" StrokeThickness="2"/><Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}" Stroke="#26000000" StrokeThickness="1"/></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#AAB4B7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#19826A"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderBrush="#AAB4B7" BorderThickness="1" Background="White"><TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="White" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#19826A"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#21745F"/><Setter TargetName="Box" Property="BorderBrush" Value="#21745F"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="14" Background="#FCFDFD" BorderBrush="#CFD7D8" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect Color="#40000000" BlurRadius="22" ShadowDepth="5" Opacity="0.32"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0"><Border Width="30" Height="30" CornerRadius="6" Background="#E1EFEB"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#21745F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,10,0" IsCancel="True" ToolTip="关闭" AutomationProperties.Name="关闭"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#667277"/></Button>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#E4E8E9" BorderThickness="0,1,0,1">
                <StackPanel Margin="24,22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#21745F" VerticalAlignment="Center"/><TextBlock Text="快捷键" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                        <TextBlock Text="功能切换" VerticalAlignment="Center" Foreground="#4F5A5E"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="CycleShortcutBox" Style="{StaticResource TextField}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="Shortcut_OnKeyDown" Padding="12,0,36,0" ToolTip="在勾选的模式之间循环切换；优先级高于其他快捷键。点击右侧 × 或按 Delete 清除停用" AutomationProperties.Name="功能切换快捷键"/>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,7,0" Click="ClearShortcut_OnClick" Tag="CycleShortcutBox" ToolTip="清空快捷键（停用）" AutomationProperties.Name="清空功能切换快捷键"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#667277"/></Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
                            <CheckBox x:Name="CycleMouseBox" Content="鼠标" IsChecked="True" Margin="0,0,12,0"/>
                            <CheckBox x:Name="CycleWritingBox" Content="手写" IsChecked="True" Margin="0,0,12,0"/>
                            <CheckBox x:Name="CycleEraserBox" Content="橡皮擦" IsChecked="True"/>
                        </StackPanel>
                        <TextBlock Text="截图" Grid.Row="2" VerticalAlignment="Center" Foreground="#4F5A5E"/>
                        <Grid Grid.Row="2" Grid.Column="1">
                            <TextBox x:Name="CaptureShortcutBox" Style="{StaticResource TextField}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="Shortcut_OnKeyDown" Padding="12,0,36,0" ToolTip="点击后按下新的快捷键；点击右侧 × 或按 Delete 清除停用" AutomationProperties.Name="截图快捷键"/>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,7,0" Click="ClearShortcut_OnClick" Tag="CaptureShortcutBox" ToolTip="清空快捷键（停用）" AutomationProperties.Name="清空截图快捷键"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#667277"/></Button>
                        </Grid>
                        <TextBlock Text="切换书写 / 操作" Grid.Row="3" VerticalAlignment="Center" Foreground="#4F5A5E"/>
                        <Grid Grid.Row="3" Grid.Column="1">
                            <TextBox x:Name="ToggleShortcutBox" Style="{StaticResource TextField}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="Shortcut_OnKeyDown" Padding="12,0,36,0" ToolTip="点击后按下新的快捷键；点击右侧 × 或按 Delete 清除停用" AutomationProperties.Name="模式切换快捷键"/>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,7,0" Click="ClearShortcut_OnClick" Tag="ToggleShortcutBox" ToolTip="清空快捷键（停用）" AutomationProperties.Name="清空模式切换快捷键"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#667277"/></Button>
                        </Grid>
                        <TextBlock Text="橡皮擦" Grid.Row="4" VerticalAlignment="Center" Foreground="#4F5A5E"/>
                        <Grid Grid.Row="4" Grid.Column="1">
                            <TextBox x:Name="EraserShortcutBox" Style="{StaticResource TextField}" IsReadOnly="True" Cursor="Hand" PreviewKeyDown="Shortcut_OnKeyDown" Padding="12,0,36,0" ToolTip="点击后按下新的快捷键；点击右侧 × 或按 Delete 清除停用" AutomationProperties.Name="橡皮擦快捷键"/>
                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,7,0" Click="ClearShortcut_OnClick" Tag="EraserShortcutBox" ToolTip="清空快捷键（停用）" AutomationProperties.Name="清空橡皮擦快捷键"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#667277"/></Button>
                        </Grid>
                    </Grid>
                    <Border Height="1" Background="#E4E8E9" Margin="0,20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#21745F" VerticalAlignment="Center"/><TextBlock Text="截图背景" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <CheckBox x:Name="SolidBackgroundBox" Content="使用纯色背景（仅保留笔迹）" Margin="0,0,0,18"/>
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=SolidBackgroundBox}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Style="{StaticResource SwatchButton}" Background="White" Tag="#FFFFFF" ToolTip="白色" Click="Swatch_OnClick"/><Button Style="{StaticResource SwatchButton}" Background="#202020" Tag="#202020" ToolTip="黑色" Click="Swatch_OnClick"/><Button Style="{StaticResource SwatchButton}" Background="#E7F2FF" Tag="#E7F2FF" ToolTip="浅蓝" Click="Swatch_OnClick"/><Button Style="{StaticResource SwatchButton}" Background="#E5F3E8" Tag="#E5F3E8" ToolTip="浅绿" Click="Swatch_OnClick"/></StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions><TextBlock Text="自定义颜色" VerticalAlignment="Center" Foreground="#4F5A5E"/><TextBox x:Name="ColorBox" Grid.Column="1" Style="{StaticResource TextField}" MaxLength="7" TextChanged="Color_OnChanged" AutomationProperties.Name="自定义背景颜色"/><Border x:Name="ColorPreview" Grid.Column="2" Width="34" Height="34" CornerRadius="6" BorderThickness="1" BorderBrush="#CFD7D8" HorizontalAlignment="Right"/></Grid>
                    </StackPanel>
                    <Border Height="1" Background="#E4E8E9" Margin="0,20"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#21745F" VerticalAlignment="Center"/><TextBlock Text="启动" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <CheckBox x:Name="StartWithWindowsBox" Content="开机时自动启动 ThinkCanvas" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AskBeforeExitBox" Content="退出时显示确认提示（可先最小化到托盘）"/>
                    <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="24,16"><TextBlock Text="更改将在保存后立即生效" Foreground="#78858A" FontSize="12" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource ActionButton}" IsCancel="True" Margin="0,0,10,0"/><Button Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_OnClick"/></StackPanel></Grid>
        </Grid>
    </Border>
</Window>
