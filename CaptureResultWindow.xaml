<Window x:Class="ThinkCanvas.CaptureResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="截图" Width="720" Height="520" MinWidth="340" MinHeight="260"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#F2F2F2">
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="复制" Width="72" Height="32" Click="Copy_OnClick" Margin="0,0,8,0"/>
                <Button Content="保存 PNG" Width="88" Height="32" Click="Save_OnClick" Margin="0,0,8,0"/>
                <Button Content="关闭" Width="72" Height="32" IsCancel="True"/>
            </StackPanel>
        </Grid>
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
    </DockPanel>
</Window>
